# Template for your secrets. Copy, edit, encrypt. Or run ./scripts/bootstrap-secrets.sh and skip to
# "editing values" below.
#
# ===================================================================================================
# THE NAMING IS THE SAFETY MECHANISM. `.sops.` IN A FILENAME MEANS ENCRYPTED, ALWAYS.
# ===================================================================================================
#
#   src/main/resources/secrets/demo-secrets.yaml.example   plaintext placeholders   COMMITTED   (this file)
#   src/main/resources/secrets/demo-secrets.yaml           plaintext, yours         GITIGNORED
#   src/main/resources/secrets/demo-secrets.sops.yaml      encrypted                COMMITTED
#
# Because the encrypted and plaintext forms have different names, .gitignore can and does protect you:
# `src/main/resources/secrets/*` is denied and only `*.sops.yaml` and `*.yaml.example` are allowed back. A plaintext
# secrets file cannot be committed by accident, even by `git add -A`.
#
# There is also a separate file called `.sops.yaml` at the repo root. That one is SOPS's *configuration*
# — it names the public key to encrypt to. It is not a secrets file. Yes, the names are unfortunate;
# they are SOPS's convention, not ours.
#
# ===================================================================================================
# SETUP — one command
# ===================================================================================================
#
# Two tools are needed: sops encrypts and decrypts the file, and age holds the key it uses.
# On macOS `brew install sops age`; on Linux take them from your distribution's package manager if
# it carries them, or the static binaries from https://github.com/getsops/sops/releases and
# https://github.com/FiloSottile/age/releases.
#
# Then, once per repo, from the project root:
#
#     ./scripts/bootstrap-secrets.sh   # idempotent
#
# That creates an age key if you have none, writes `.sops.yaml` with your public key, and creates
# `src/main/resources/secrets/demo-secrets.sops.yaml` by encrypting this example **directly**. The real file is therefore
# born encrypted: at no point does a plaintext copy of it exist on disk. That matters — the plaintext
# window is where credentials get left behind.
#
# ===================================================================================================
# EDITING VALUES
# ===================================================================================================
#
# Preferred, because no plaintext ever touches the disk:
#
#     sops src/main/resources/secrets/demo-secrets.sops.yaml      # opens $EDITOR, re-encrypts on save
#
# For bulk editing, if you would rather work in a plain file:
#
#     sops --decrypt src/main/resources/secrets/demo-secrets.sops.yaml > src/main/resources/secrets/demo-secrets.yaml   # gitignored
#     $EDITOR src/main/resources/secrets/demo-secrets.yaml
#     ./scripts/encrypt-secrets.sh             # writes the .sops.yaml form, removes the plaintext
#
# Check state at any time:
#
#     grep -q '^sops:' src/main/resources/secrets/demo-secrets.sops.yaml && echo ENCRYPTED || echo PLAINTEXT
#
# An example file having no `sops:` block is correct — the block appears only after encryption.
#
# ===================================================================================================
# VALUES
# ===================================================================================================
#
# MOST DEMOS NEED NOTHING HERE.
#
# Only two kinds of value live in this file: an SSH password for the `hosts` platform, and anything
# else you choose to reference from `demo-config.yaml` with a `secrets:` entry. Licences are paths,
# registry tokens are environment variable *names*, and the Control Center admin password is written
# into demo-config.yaml because its schema offers nowhere else. None of those belong here.
#
# So a GKE or EKS demo needs no entry at all, and a `hosts` demo using key authentication needs no
# entry either. The wizard's secrets page says which entries your own answers require, by name.
#
# The entries below are COMMENTED OUT on purpose. They are worked examples of the shape, not
# requirements — uncomment only what your demo references, and delete the rest. They used to be
# live, which meant `bootstrap-secrets.sh` encrypted another demo's Postgres and root passwords
# straight into your real secrets file, and a first-time reader had no way to tell that none of it
# applied to them.
#
# The one live entry below is not a secret and is deliberately not encrypted. It is here because
# sops refuses a file with no data in it at all — `sops --encrypt` on a file of pure comments fails
# with "Error unmarshalling file: EOF" — so the file needs at least one mapping entry to exist.
# Its name ends in `_unencrypted`, which is sops's own default `unencrypted_suffix`, so the value
# stays readable in the committed encrypted file and nobody deletes it wondering what it is.
# Leave it alone; it costs nothing and the file will not encrypt without it.
#
sops_needs_one_live_entry_unencrypted: nothing here is a secret

# --- Worked example: an SSH password for the `hosts` platform -------------------------------------
#
# The only value the toolkit itself resolves from this file. Referenced from an infrastructure
# account, where the wizard writes both halves for you if you choose password authentication:
#
#   infrastructure_accounts:
#     my-machines:
#       provider: host
#       host_user: root
#       host_access:
#         kind: ssh
#         auth:
#           kind: password
#           password_secret_ref: host-login      # the entry name below
#           password_key: password                # the field within it
#
# Read on the controller at deploy time and never written to a machine. Prefer key authentication
# where you can install a key — a password is read on every run and is strictly more exposure. See
# the toolkit skill for what the password path does to contain it.
#
# host-login:
#   username: root
#   password: root-pw-replace-me

# --- Worked example: a database password referenced by name ----------------------------------------
#
# Anything you add to `demo-config.yaml` under `secrets:` can take its value from here:
#
#   secrets:
#     my-database-auth:
#       source: { kind: sops, file: src/main/resources/secrets/demo-secrets.sops.yaml, path: my-database-auth }
#
# Every password ends in `-replace-me` on purpose, so an unedited copy is obvious.
#
# my-database-auth:
#   username: app
#   password: app-pw-replace-me
