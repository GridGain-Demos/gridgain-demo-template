# Template for your secrets. Copy, edit, encrypt. Or run ./scripts/bootstrap-secrets.sh and skip to
# "editing values" below.
#
# ===================================================================================================
# THE NAMING IS THE SAFETY MECHANISM. `.sops.` IN A FILENAME MEANS ENCRYPTED, ALWAYS.
# ===================================================================================================
#
#   src/main/resources/secrets/demo-secrets.yaml.example   plaintext placeholders   COMMITTED   (this file)
#   src/main/resources/secrets/demo-secrets.yaml           plaintext, yours         GITIGNORED
#   src/main/resources/secrets/demo-secrets.sops.yaml      encrypted                COMMITTED
#
# Because the encrypted and plaintext forms have different names, .gitignore can and does protect you:
# `src/main/resources/secrets/*` is denied and only `*.sops.yaml` and `*.yaml.example` are allowed back. A plaintext
# secrets file cannot be committed by accident, even by `git add -A`.
#
# There is also a separate file called `.sops.yaml` at the repo root. That one is SOPS's *configuration*
# — it names the public key to encrypt to. It is not a secrets file. Yes, the names are unfortunate;
# they are SOPS's convention, not ours.
#
# ===================================================================================================
# SETUP — one command
# ===================================================================================================
#
#     brew install sops age            # once per laptop
#     ./scripts/bootstrap-secrets.sh   # once per repo; idempotent
#
# That creates an age key if you have none, writes `.sops.yaml` with your public key, and creates
# `src/main/resources/secrets/demo-secrets.sops.yaml` by encrypting this example **directly**. The real file is therefore
# born encrypted: at no point does a plaintext copy of it exist on disk. That matters — the plaintext
# window is where credentials get left behind.
#
# ===================================================================================================
# EDITING VALUES
# ===================================================================================================
#
# Preferred, because no plaintext ever touches the disk:
#
#     sops src/main/resources/secrets/demo-secrets.sops.yaml      # opens $EDITOR, re-encrypts on save
#
# For bulk editing, if you would rather work in a plain file:
#
#     sops --decrypt src/main/resources/secrets/demo-secrets.sops.yaml > src/main/resources/secrets/demo-secrets.yaml   # gitignored
#     $EDITOR src/main/resources/secrets/demo-secrets.yaml
#     ./scripts/encrypt-secrets.sh             # writes the .sops.yaml form, removes the plaintext
#
# Check state at any time:
#
#     grep -q '^sops:' src/main/resources/secrets/demo-secrets.sops.yaml && echo ENCRYPTED || echo PLAINTEXT
#
# An example file having no `sops:` block is correct — the block appears only after encryption.
#
# ===================================================================================================
# VALUES
# ===================================================================================================
#
# Each top-level key is one `secrets:` entry in demo-config.yaml, referenced by name. Every password
# below ends in `-replace-me` on purpose, so an unedited copy is obvious.

# Referenced from demo-config.yaml as:
#   secrets:
#     postgres-auth:
#       source: { kind: sops, file: src/main/resources/secrets/demo-secrets.sops.yaml, path: postgres-auth }
postgres-auth:
  username: payments
  password: payments-pw-replace-me

# A host password for the 'hosts' platform. Referenced from an infrastructure account as:
#   infrastructure_accounts:
#     power-lab:
#       provider: host
#       host_user: root
#       host_access:
#         kind: ssh
#         auth:
#           kind: password
#           password_secret_ref: host-root-auth   # this entry
#           password_key: password                # the field below
#
# Prefer key authentication where you can install a key — a password is read on every run and is
# strictly more exposure. See the toolkit skill for what the password path does to contain it.
host-root-auth:
  username: root
  password: root-pw-replace-me
