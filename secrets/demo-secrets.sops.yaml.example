# Template for `secrets/demo-secrets.sops.yaml`. NOT used directly: copy it, edit the values, encrypt it.
#
# ===================================================================================================
# QUICK START — or just run ./scripts/bootstrap-secrets.sh, which does steps 1 to 4 for you.
# ===================================================================================================
#
#   1. Install the tools:            brew install sops age
#   2. Create a key, once per laptop:
#                                    mkdir -p ~/.config/sops/age
#                                    age-keygen -o ~/.config/sops/age/keys.txt
#                                    echo 'export SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt' >> ~/.zshrc
#                                    source ~/.zshrc
#   3. Create SOPS's CONFIG file, once per repo — THIS IS THE STEP PEOPLE MISS:
#                                    cp .sops.yaml.example .sops.yaml
#                                    age-keygen -y "$SOPS_AGE_KEY_FILE"      # prints your PUBLIC key
#                                    # paste that key into .sops.yaml's `age:` field
#   4. Create your secrets file:     cp secrets/demo-secrets.sops.yaml.example \
#                                       secrets/demo-secrets.sops.yaml
#   5. Edit the values below in your copy. They are plaintext at this point.
#   6. Encrypt it:                   sops --encrypt --in-place secrets/demo-secrets.sops.yaml
#   7. Install the safety net, once per clone:
#                                    git config core.hooksPath .githooks
#   8. Commit:                       git add .sops.yaml secrets/demo-secrets.sops.yaml
#
# To edit values later:  sops secrets/demo-secrets.sops.yaml   (opens $EDITOR, re-encrypts on save)
#
# ===================================================================================================
# WHAT ENCRYPTED LOOKS LIKE
# ===================================================================================================
#
# This example file has NO `sops:` block, and that is correct — the block only appears after step 6.
# So "my copy looks like the example" does not mean it is encrypted. Check with:
#
#     grep -q '^sops:' secrets/demo-secrets.sops.yaml && echo ENCRYPTED || echo PLAINTEXT
#
# After encryption every `value` becomes `ENC[AES256_GCM,data:...,iv:...,tag:...,type:str]` and a
# `sops:` block is appended holding the data key wrapped for each recipient.
#
# ===================================================================================================
# WHY .gitignore CANNOT PROTECT YOU HERE
# ===================================================================================================
#
# `secrets/demo-secrets.sops.yaml` has the same name whether or not it has been encrypted, so no path
# rule can tell the safe case from the one that commits a password into git history — where removing it
# means rewriting history, not deleting a file.
#
# `.githooks/pre-commit` is what actually protects you: it refuses to commit a `secrets/*.sops.yaml`
# with no `sops:` block. Enable it with step 7 above. Do not skip that step because everything appears
# to work without it; the failure mode is silent and permanent.
#
# ===================================================================================================
# VALUES
# ===================================================================================================
#
# Each top-level key is one `secrets:` entry in demo-config.yaml, referenced by name. Every password
# below ends in `-replace-me` on purpose, so an unedited copy is obvious.

# Referenced from demo-config.yaml as:
#   secrets:
#     postgres-auth:
#       source: { kind: sops, file: secrets/demo-secrets.sops.yaml, path: postgres-auth }
postgres-auth:
  username: payments
  password: payments-pw-replace-me

# A host password for the 'hosts' platform. Referenced from an infrastructure account as:
#   infrastructure_accounts:
#     power-lab:
#       provider: host
#       host_user: root
#       host_access:
#         kind: ssh
#         auth:
#           kind: password
#           password_secret_ref: host-root-auth   # this entry
#           password_key: password                # the field below
#
# Prefer key authentication where you can install a key — a password is read on every run and is
# strictly more exposure. See the toolkit skill for what the password path does to contain it.
host-root-auth:
  username: root
  password: root-pw-replace-me
